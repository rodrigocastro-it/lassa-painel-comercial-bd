DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_SERVER=seu_servidor
DB_DATABASE=nome_do_banco
PORT=8787

# Login do painel (tela de acesso do piloto). Formato "usuario:senha,usuario:senha,...".
# Se não definir, usa os usuários padrão combinados (ver server.js) — todos com o
# mesmo nível de acesso. Troque para os valores reais antes de expor o painel.
AUTH_USERS=lassa:lassaleite,moacirneto:moacirnetoleite,moacirfilho:moacirfilholeite,zuleika:zuleikaleite